{
  "manifest_version": 3,
  "name": "Chat to Markdown for Gemini",
  "version": "0.1.0",
  "minimum_chrome_version": "102",
  "description": "Gemini の会話を、画像も含めて Markdown ファイルに書き出します。非公式の拡張機能で、Google とは関係ありません。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gemini の会話を Markdown に書き出す",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["scripting", "downloads"],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://lh3.googleusercontent.com/*",
    "https://lh3.google.com/*"
  ]
}
